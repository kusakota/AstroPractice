---
import Layout from "../../layouts/Layout.astro";
import kikakuList from "../../kikaku/kikakuList.json";
interface Props {
  title: string;
  description: string;
  pageType?: "website" | "article";
  image: string;
  imageAlt: string;
}
const head: Props = {
  title: "最新ニュース",
  description: "最新のニュースをお届け！",
  pageType: "article",
  image: "/path/to/image.jpg",
  imageAlt: "Sample Image Alt Text"
};

---
<Layout  {...head}>
  <h1>企画一覧</h1>
  <ul>
    {kikakuList.map((kikaku) => (
      <li>
        <a href={`/kikaku/${kikaku.kikaku_id}/`}>{kikaku.name}</a>
      </li>
    ))}
  </ul>
</Layout>
<style lang="scss" scoped>
ul{
    li{
        margin: 12px;
    }
}
</style>