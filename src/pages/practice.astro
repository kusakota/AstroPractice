---
import FontAwesomeIcon from "../components/atoms/FontAwesomeIcon.astro";
import { faAngleRight, faHouse} from "@fortawesome/free-solid-svg-icons";
import Layout from "../layouts/Layout.astro";
import Typesetting from "../components/atoms/Typesetting.astro";
import BottomSheet from "../components/atoms/BottomSheet.vue";
---
<Layout 
	title= "Sample Title",
	description="Sample Description",
	pageType="article",
	image= "/path/to/image.jpg",
	imageAlt= "Sample Image Alt Text"
>
	<h1>
		Hello World
	</h1>
	<span class="icon">
		<FontAwesomeIcon icon={faAngleRight} />
	</span>
  <section >
    <h2>見出し</h2>
		<BottomSheet client:load>
			<ul>
				<li>1</li>
				<li>2</li>
				<li>3</li>
			</ul>
		</BottomSheet>
	</section>
	<FontAwesomeIcon icon={faHouse} />
</Layout>
<style lang="scss" scoped>
.icon{
	color: red;
	font-size: 64px;
}
.text{
  width: 520px;
  font-family: 'ryo-gothic-plusn';
}
</style>