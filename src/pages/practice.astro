---
import FontAwesomeIcon from "../components/atoms/FontAwesomeIcon.astro";
import { faAngleRight, faHouse} from "@fortawesome/free-solid-svg-icons";
import Layout from "../layouts/Layout.astro";
import Typesetting from "../components/atoms/Typesetting.astro";
import BottomSheet from "../components/atoms/BottomSheet.vue";
import { ref } from 'vue';

// Vueコンポーネントの初期状態を管理
// 'closed' または 'partial'
const sheetState = ref('closed');
---
<Layout 
	title= "Sample Title",
	description="Sample Description",
	pageType="article",
	image= "/path/to/image.jpg",
	imageAlt= "Sample Image Alt Text"
>
	<h1>
		Hello World
	</h1>
	<span class="icon">
		<FontAwesomeIcon icon={faAngleRight} />
	</span>
  <section >
    <h2>見出し</h2>
    <p class="text">
    <Typesetting>
      「彼は言った。『文字組みは美しさと可読性のバランスが重要だ』。」、（12時間）は
    </Typesetting>
    </p>
    <div class="text">
      「彼は言った。『文字組みは美しさと可読性のバランスが重要だ』。」、（12時間）は
    </div>
		</section>
		<BottomSheet client:load v-model={sheetState}>
    <h2>メニュー</h2>
    <p>ここにリストなどを表示できます。</p>
    <ul>
      <li>プロフィール</li>
      <li>設定</li>
      <li>ログアウト</li>
    </ul>
  </BottomSheet>
	<FontAwesomeIcon icon={faHouse} />
</Layout>
<style lang="scss" scoped>
.icon{
	color: red;
	font-size: 64px;
}
.text{
  width: 520px;
  font-family: 'ryo-gothic-plusn';
}
</style>